// The API's HTTP handlers: each handler reads a request, executes business
// logic and writes a JSON response.
package main

import (
{{- if .NeedsDB}}
	"context"
	"time"
{{- end}}
	"net/http"

	"{{.ModulePath}}/internal/response"
	"{{.ModulePath}}/internal/version"
)

// healthcheck displays the application's health and version information.
func (app *application) healthcheck(w http.ResponseWriter, r *http.Request) {
	data := map[string]any{
		"status":   "available",
		"version":  version.Get(),
		"revision": version.GetRevision(),
	}
{{- if .NeedsDB}}

	// Check that the database connection is still alive.
	ctx, cancel := context.WithTimeout(r.Context(), 5*time.Second)
	defer cancel()

	if err := app.db.PingContext(ctx); err != nil {
		data["status"] = "unavailable"
		app.serverError(w, r, err)
		return
	}

	data["db"] = map[string]any{
		"max_open_conns": app.db.Stats().MaxOpenConnections,
		"open_conns":     app.db.Stats().OpenConnections,
		"in_use":         app.db.Stats().InUse,
	}
{{- end}}

	err := response.WriteJSON(w, http.StatusOK, data, nil)
	if err != nil {
		app.serverError(w, r, err)
	}
}
