// The API entrypoint: configuration and dependency initialization.
package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
{{- if .NeedsDB}}
	"time"
{{- end}}

{{- if eq .LogFormat "colorized"}}
	"{{.ModulePath}}/internal/log"

{{- end}}
{{- if eq .ConfigSource "env"}}
	"{{.ModulePath}}/internal/env"

{{- else}}
	"flag"

{{- end}}
{{- if .AccountsJWT}}
	"{{.ModulePath}}/internal/auth"

{{- end}}
{{- if .NeedsMailer}}
	"{{.ModulePath}}/internal/funcs"
	"{{.ModulePath}}/internal/mailer"

{{- end}}
{{- if .Migrations}}
	"{{.ModulePath}}/assets"

{{- end}}
{{- if .NeedsDB}}
	_ "{{.Driver.ImportPath}}"

	"github.com/jmoiron/sqlx"

	"{{.ModulePath}}/internal/database"
{{- end}}
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}

// run performs the startup and shutdown of the application. All errors are
// returned and handled by main, keeping this function's control flow simple.
func run() error {
{{- if eq .ConfigSource "flags"}}
	var cfg config

	flag.StringVar(&cfg.baseURL, "base-url", "http://localhost:{{.Port}}", "base URL for the application")
	flag.IntVar(&cfg.httpPort, "http-port", {{.Port}}, "port to serve the application on")
{{- if .NeedsDB}}
	flag.StringVar(&cfg.db.dsn, "db-dsn", "{{.Driver.ExampleDSN}}", "database DSN")
	flag.IntVar(&cfg.db.maxOpenConns, "db-max-open-conns", 25, "maximum open database connections")
	flag.IntVar(&cfg.db.maxIdleConns, "db-max-idle-conns", 25, "maximum idle database connections")
	flag.DurationVar(&cfg.db.maxIdleTime, "db-max-idle-time", 5*time.Minute, "maximum idle time for database connections")
	flag.DurationVar(&cfg.db.maxLifetime, "db-max-lifetime", 2*time.Hour, "maximum lifetime for database connections")
{{- if .Migrations}}
	flag.BoolVar(&cfg.db.automigrate, "db-automigrate", true, "apply up migrations automatically on startup")
{{- end}}
{{- end}}
{{- if .BasicAuth}}
	flag.StringVar(&cfg.basicAuth.username, "basic-auth-username", "admin", "basic auth username")
	flag.StringVar(&cfg.basicAuth.hashedPassword, "basic-auth-hashed-password", "{{.BasicAuthHashedPassword}}", "basic auth bcrypt-hashed password")
{{- end}}
{{- if .SecureCookies}}
	flag.StringVar(&cfg.cookie.secretKey, "cookie-secret-key", "{{.CookieSecretKey}}", "32-character secret key for cookie signing and encryption")
{{- end}}
{{- if .NeedsMailer}}
	flag.StringVar(&cfg.smtp.host, "smtp-host", "localhost", "SMTP server host")
	flag.IntVar(&cfg.smtp.port, "smtp-port", 25, "SMTP server port")
	flag.StringVar(&cfg.smtp.username, "smtp-username", "", "SMTP server username")
	flag.StringVar(&cfg.smtp.password, "smtp-password", "", "SMTP server password")
	flag.StringVar(&cfg.smtp.from, "smtp-from", "noreply@localhost", "sender name and email address")
{{- end}}
{{- if .ErrorNotifications}}
	flag.StringVar(&cfg.notifications.email, "notifications-email", "", "email address to send error notifications to; empty disables notifications")
{{- end}}
{{- if .AutoHTTPS}}
	flag.StringVar(&cfg.autoHTTPS.domain, "auto-https-domain", "", "domain name to provision TLS certificates for")
	flag.StringVar(&cfg.autoHTTPS.email, "auto-https-email", "", "contact email address for certificate problem notifications")
	flag.BoolVar(&cfg.autoHTTPS.staging, "auto-https-staging", false, "use the Let's Encrypt staging environment")
{{- end}}
{{- if .AccountsJWT}}
	flag.StringVar(&cfg.jwt.secret, "jwt-secret", "{{.CookieSecretKey}}", "32-character secret key for signing authentication tokens")
{{- end}}
	flag.Parse()
{{- else}}
	// Read the configuration settings for the application from
	// environment variables.
	cfg := config{
		baseURL:  env.GetString("BASE_URL", "http://localhost:{{.Port}}"),
		httpPort: env.GetInt("HTTP_PORT", {{.Port}}),
{{- if .NeedsDB}}
		db: dbConfig{
			dsn:          env.GetString("DB_DSN", "{{.Driver.ExampleDSN}}"),
			maxOpenConns: env.GetInt("DB_MAX_OPEN_CONNS", 25),
			maxIdleConns: env.GetInt("DB_MAX_IDLE_CONNS", 25),
			maxIdleTime:  env.GetDuration("DB_MAX_IDLE_TIME", 5*time.Minute),
			maxLifetime:  env.GetDuration("DB_MAX_LIFETIME", 2*time.Hour),
{{- if .Migrations}}
			automigrate: env.GetBool("DB_AUTOMIGRATE", true),
{{- end}}
		},
{{- end}}
{{- if .BasicAuth}}
		basicAuth: basicAuthConfig{
			username:       env.GetString("BASIC_AUTH_USERNAME", "admin"),
			hashedPassword: env.GetString("BASIC_AUTH_HASHED_PASSWORD", "{{.BasicAuthHashedPassword}}"),
		},
{{- end}}
{{- if .SecureCookies}}
		cookie: cookieConfig{
			secretKey: env.GetString("COOKIE_SECRET_KEY", "{{.CookieSecretKey}}"),
		},
{{- end}}
{{- if .NeedsMailer}}
		smtp: smtpConfig{
			host:     env.GetString("SMTP_HOST", "localhost"),
			port:     env.GetInt("SMTP_PORT", 25),
			username: env.GetString("SMTP_USERNAME", ""),
			password: env.GetString("SMTP_PASSWORD", ""),
			from:     env.GetString("SMTP_FROM", "noreply@localhost"),
		},
{{- end}}
{{- if .ErrorNotifications}}
		notifications: notificationsConfig{
			email: env.GetString("NOTIFICATIONS_EMAIL", ""),
		},
{{- end}}
{{- if .AutoHTTPS}}
		autoHTTPS: autoHTTPSConfig{
			domain:  env.GetString("AUTO_HTTPS_DOMAIN", ""),
			email:   env.GetString("AUTO_HTTPS_EMAIL", ""),
			staging: env.GetBool("AUTO_HTTPS_STAGING", false),
		},
{{- end}}
{{- if .AccountsJWT}}
		jwt: jwtConfig{
			secret: env.GetString("JWT_SECRET", "{{.CookieSecretKey}}"),
		},
{{- end}}
	}
{{- end}}

	logger := newLogger()

{{- if .NeedsDB}}
	ctx, cancel := context.WithTimeout(context.Background(), database.DefaultTimeout)
	defer cancel()

	db, err := database.New(ctx, database.Config{
		DSN:          cfg.db.dsn,
		MaxOpenConns: cfg.db.maxOpenConns,
		MaxIdleConns: cfg.db.maxIdleConns,
		MaxIdleTime:  cfg.db.maxIdleTime,
		MaxLifetime:  cfg.db.maxLifetime,
	})
	if err != nil {
		return fmt.Errorf("connecting to database: %w", err)
	}
	defer db.Close()

	logger.Info("database connection pool established", "dsn", cfg.db.dsn)
{{- if .Migrations}}
	if cfg.db.automigrate {
		if err := database.MigrateUp(db, assets.Migrations); err != nil {
			return fmt.Errorf("running migrations: %w", err)
		}
		logger.Info("database migrations applied")
	}
{{- end}}
{{- end}}
{{- if .NeedsMailer}}
	mailer, err := mailer.New(logger, assets.EmailFiles, funcs.All(), cfg.smtp.host, cfg.smtp.port, cfg.smtp.username, cfg.smtp.password, cfg.smtp.from)
	if err != nil {
		return fmt.Errorf("initializing mailer: %w", err)
	}

	logger.Info("mailer initialized", "host", cfg.smtp.host, "port", cfg.smtp.port)
{{- end}}
{{- if .AccountsJWT}}
	tokenizer, err := auth.NewTokenizer(cfg.jwt.secret)
	if err != nil {
		return fmt.Errorf("initializing tokenizer: %w", err)
	}
{{- end}}

	app := &application{
		config: cfg,
		logger: logger,
{{- if .NeedsDB}}
		db: db,
{{- end}}
{{- if .NeedsMailer}}
		mailer: mailer,
{{- end}}
{{- if .AccountsJWT}}
		tokenizer:        tokenizer,
		users:            database.UserModel{DB: db},
		activationTokens: database.ActivationTokenModel{DB: db},
{{- end}}
	}

	srv := app.newServer()

	shutdownError := make(chan error)

	go func() {
		quit := make(chan os.Signal, 1)
		signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
		<-quit

		logger.Info("shutting down server", slog.Group("server", "addr", srv.Addr))
		shutdownError <- srv.Shutdown(context.Background())
	}()

	logger.Info("starting server", slog.Group("server", "addr", srv.Addr))

{{- if .AutoHTTPS}}
	if cfg.autoHTTPS.domain != "" {
		err = app.serveAutoHTTPS(srv)
	} else {
		err = srv.ListenAndServe()
	}
{{- else}}
{{- if or .NeedsDB .NeedsMailer .AccountsJWT}}
	err = srv.ListenAndServe()
{{- else}}
	err := srv.ListenAndServe()
{{- end}}
{{- end}}
	if !errors.Is(err, http.ErrServerClosed) {
		return err
	}

	err = <-shutdownError
	if err != nil {
		return err
	}

	logger.Info("stopped server", slog.Group("server", "addr", srv.Addr))

	return nil
}

// config holds the configuration settings for the application.
type config struct {
	baseURL  string
	httpPort int
{{- if .NeedsDB}}
	db dbConfig
{{- end}}
{{- if .BasicAuth}}
	basicAuth basicAuthConfig
{{- end}}
{{- if .SecureCookies}}
	cookie cookieConfig
{{- end}}
{{- if .NeedsMailer}}
	smtp smtpConfig
{{- end}}
{{- if .ErrorNotifications}}
	notifications notificationsConfig
{{- end}}
{{- if .AutoHTTPS}}
	autoHTTPS autoHTTPSConfig
{{- end}}
{{- if .AccountsJWT}}
	jwt jwtConfig
{{- end}}
}

{{- if .NeedsDB}}

// dbConfig holds the database connection pool settings.
type dbConfig struct {
	dsn          string
	maxOpenConns int
	maxIdleConns int
	maxIdleTime  time.Duration
	maxLifetime  time.Duration
{{- if .Migrations}}
	automigrate bool
{{- end}}
}
{{- end}}
{{- if .BasicAuth}}

// basicAuthConfig holds the HTTP basic authentication credentials. The
// password is stored as a bcrypt hash.
type basicAuthConfig struct {
	username       string
	hashedPassword string
}
{{- end}}
{{- if .SecureCookies}}

// cookieConfig holds the secret key used for cookie signing and
// encryption.
type cookieConfig struct {
	secretKey string
}
{{- end}}
{{- if .NeedsMailer}}

// smtpConfig holds the settings for the outgoing mail server.
type smtpConfig struct {
	host     string
	port     int
	username string
	password string
	from     string
}
{{- end}}
{{- if .ErrorNotifications}}

// notificationsConfig holds the recipient for error notification
// emails.
type notificationsConfig struct {
	email string
}
{{- end}}
{{- if .AutoHTTPS}}

// autoHTTPSConfig holds the settings for automatically provisioned TLS
// certificates.
type autoHTTPSConfig struct {
	domain  string
	email   string
	staging bool
}
{{- end}}
{{- if .AccountsJWT}}

// jwtConfig holds the secret key used for signing authentication
// tokens.
type jwtConfig struct {
	secret string
}
{{- end}}

// application holds the dependencies of the application. Handlers, helpers
// and middleware are defined as methods on this type.
type application struct {
	config config
	logger *slog.Logger
{{- if .NeedsDB}}
	db *sqlx.DB
{{- end}}
{{- if .NeedsMailer}}
	mailer mailer.Mailer
{{- end}}
{{- if .AccountsJWT}}
	tokenizer        auth.Tokenizer
	users            database.UserModel
	activationTokens database.ActivationTokenModel
{{- end}}
	wg sync.WaitGroup
}

// newLogger returns a slog.Logger writing records to standard output in
// the configured format.
func newLogger() *slog.Logger {
{{- if eq .LogFormat "json"}}
	return slog.New(slog.NewJSONHandler(os.Stdout, nil))
{{- else if eq .LogFormat "colorized"}}
	return slog.New(log.NewColorizedHandler(os.Stdout))
{{- else}}
	return slog.New(slog.NewTextHandler(os.Stdout, nil))
{{- end}}
}
