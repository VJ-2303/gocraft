// The API entrypoint: configuration, dependency initialization and the
// HTTP server lifecycle.
package main

import (
	"context"
	"errors"
	"fmt"
	"log/slog"
	"net/http"
	"os"
	"os/signal"
	"sync"
	"syscall"
	"time"

{{- if .AutoHTTPS}}
	"crypto/tls"
	"net/url"

	"golang.org/x/crypto/acme/autocert"

{{- end}}
{{- if eq .LogFormat "colorized"}}
	"{{.ModulePath}}/internal/log"

{{- end}}
{{- if eq .ConfigSource "env"}}
	"{{.ModulePath}}/internal/env"

{{- else}}
	"flag"

{{- end}}
{{- if .NeedsMailer}}
	"{{.ModulePath}}/internal/funcs"
	"{{.ModulePath}}/internal/mailer"

{{- end}}
{{- if .AccountsJWT}}
	"{{.ModulePath}}/internal/auth"

{{- end}}
{{- if .Migrations}}
	"{{.ModulePath}}/assets"

{{- end}}
{{- if .NeedsDB}}
	_ "{{.Driver.ImportPath}}"

	"github.com/jmoiron/sqlx"

	"{{.ModulePath}}/internal/database"
{{- end}}
)

func main() {
	if err := run(); err != nil {
		fmt.Fprintf(os.Stderr, "error: %v\n", err)
		os.Exit(1)
	}
}

// run performs the startup and shutdown of the application. All errors are
// returned and handled by main, keeping this function's control flow simple.
func run() error {
{{- if eq .ConfigSource "flags"}}
	// Parse the configuration settings for the application from the
	// command-line flags.
	var cfg config

	flag.StringVar(&cfg.baseURL, "base-url", "http://localhost:{{.Port}}", "base URL for the application")
	flag.IntVar(&cfg.httpPort, "http-port", {{.Port}}, "port to serve the application on")
{{- if .NeedsDB}}
	flag.StringVar(&cfg.dbDSN, "db-dsn", "{{.Driver.ExampleDSN}}", "database DSN")
	flag.IntVar(&cfg.dbMaxConns, "db-max-conns", 25, "maximum open database connections")
	flag.IntVar(&cfg.dbMinConns, "db-min-conns", 0, "minimum idle database connections")
	flag.DurationVar(&cfg.dbMaxIdleTime, "db-max-idle-time", 15*time.Minute, "maximum idle time for database connections")
{{- if .Migrations}}
	flag.BoolVar(&cfg.dbAutomigrate, "db-automigrate", true, "apply up migrations automatically on startup")
{{- end}}
{{- end}}
{{- if .BasicAuth}}
	flag.StringVar(&cfg.basicAuthUsername, "basic-auth-username", "admin", "basic auth username")
	flag.StringVar(&cfg.basicAuthPassword, "basic-auth-password", "password", "basic auth password")
{{- end}}
{{- if .SecureCookies}}
	flag.StringVar(&cfg.cookieSecretKey, "cookie-secret-key", "{{.CookieSecretKey}}", "32-character secret key for cookie signing and encryption")
{{- end}}
{{- if .AccountsJWT}}
	flag.StringVar(&cfg.jwtSecret, "jwt-secret", "{{.CookieSecretKey}}", "32-character secret key for signing authentication tokens")
{{- end}}
{{- if .NeedsMailer}}
	flag.StringVar(&cfg.smtpHost, "smtp-host", "localhost", "SMTP server host")
	flag.IntVar(&cfg.smtpPort, "smtp-port", 25, "SMTP server port")
	flag.StringVar(&cfg.smtpUsername, "smtp-username", "", "SMTP server username")
	flag.StringVar(&cfg.smtpPassword, "smtp-password", "", "SMTP server password")
	flag.StringVar(&cfg.smtpFrom, "smtp-from", "noreply@localhost", "sender name and email address")
{{- end}}
{{- if .ErrorNotifications}}
	flag.StringVar(&cfg.adminEmail, "admin-email", "admin@localhost", "admin email address for error notifications")
{{- end}}
{{- if .AutoHTTPS}}
	flag.IntVar(&cfg.httpsPort, "https-port", 443, "port to serve the application on over HTTPS")
{{- end}}
	flag.Parse()
{{- else}}
	// Read the configuration settings for the application from
	// environment variables.
	cfg := config{
		baseURL:  env.GetString("BASE_URL", "http://localhost:{{.Port}}"),
		httpPort: env.GetInt("HTTP_PORT", {{.Port}}),
{{- if .NeedsDB}}
		dbDSN:         env.GetString("DB_DSN", "{{.Driver.ExampleDSN}}"),
		dbMaxConns:    env.GetInt("DB_MAX_CONNS", 25),
		dbMinConns:    env.GetInt("DB_MIN_CONNS", 0),
		dbMaxIdleTime: env.GetDuration("DB_MAX_IDLE_TIME", 15*time.Minute),
{{- if .Migrations}}
		dbAutomigrate: env.GetBool("DB_AUTOMIGRATE", true),
{{- end}}
{{- end}}
{{- if .BasicAuth}}
		basicAuthUsername: env.GetString("BASIC_AUTH_USERNAME", "admin"),
		basicAuthPassword: env.GetString("BASIC_AUTH_PASSWORD", "password"),
{{- end}}
{{- if .SecureCookies}}
		cookieSecretKey:   env.GetString("COOKIE_SECRET_KEY", "{{.CookieSecretKey}}"),
{{- end}}
{{- if .NeedsMailer}}
		smtpHost:     env.GetString("SMTP_HOST", "localhost"),
		smtpPort:     env.GetInt("SMTP_PORT", 25),
		smtpUsername: env.GetString("SMTP_USERNAME", ""),
		smtpPassword: env.GetString("SMTP_PASSWORD", ""),
		smtpFrom:     env.GetString("SMTP_FROM", "noreply@localhost"),
{{- end}}
{{- if .ErrorNotifications}}
		adminEmail: env.GetString("ADMIN_EMAIL", "admin@localhost"),
{{- end}}
{{- if .AutoHTTPS}}
		httpsPort: env.GetInt("HTTPS_PORT", 443),
{{- end}}
	}
{{- end}}

	// Initialize a logger writing to standard output.
	logger := newLogger()

{{- if .NeedsDB}}
	// Initialize the database connection pool.
	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
	defer cancel()

	db, err := database.New(ctx, database.Config{
		DSN:          cfg.dbDSN,
		MaxOpenConns: cfg.dbMaxConns,
		MaxIdleConns: cfg.dbMinConns,
		MaxIdleTime:  cfg.dbMaxIdleTime,
	})
	if err != nil {
		return fmt.Errorf("connecting to database: %w", err)
	}
	defer db.Close()

	logger.Info("database connection pool established", "dsn", cfg.dbDSN)
{{- if .Migrations}}
	if cfg.dbAutomigrate {
		if err := database.MigrateUp(db, assets.Migrations); err != nil {
			return fmt.Errorf("running migrations: %w", err)
		}
		logger.Info("database migrations applied")
	}
{{- end}}
{{- end}}

{{- if .NeedsMailer}}

	// Initialize the mailer with the embedded email templates and the
	// configured SMTP settings.
	mailer, err := mailer.New(logger, assets.EmailFiles, funcs.All(), cfg.smtpHost, cfg.smtpPort, cfg.smtpUsername, cfg.smtpPassword, cfg.smtpFrom)
	if err != nil {
		return fmt.Errorf("initializing mailer: %w", err)
	}

	logger.Info("mailer initialized", "host", cfg.smtpHost, "port", cfg.smtpPort)
{{- end}}
{{- if .AccountsJWT}}

	// Initialize the JWT tokenizer for bearer-token authentication.
	tokenizer, err := auth.NewTokenizer(cfg.jwtSecret)
	if err != nil {
		return fmt.Errorf("initializing tokenizer: %w", err)
	}
{{- end}}

	app := &application{
		config: cfg,
		logger: logger,
{{- if .NeedsDB}}
		db: db,
{{- end}}
{{- if .NeedsMailer}}
		mailer: mailer,
{{- end}}
{{- if .AccountsJWT}}
		tokenizer:        tokenizer,
		users:            database.UserModel{DB: db},
		activationTokens: database.ActivationTokenModel{DB: db},
{{- end}}
	}

	// Initialize a new http.Server instance with sensible timeout settings.
	srv := &http.Server{
		Addr:         fmt.Sprintf(":%d", cfg.httpPort),
		Handler:      app.routes(),
		IdleTimeout:  time.Minute,
		ReadTimeout:  5 * time.Second,
		WriteTimeout: 10 * time.Second,
		ErrorLog:     slog.NewLogLogger(logger.Handler(), slog.LevelError),
	}
{{- if .AutoHTTPS}}

	// Parse the base URL to determine the hostname for the TLS
	// certificate. Automatic HTTPS via Let's Encrypt is enabled for real
	// hostnames; local development falls back to plain HTTP.
	u, err := url.Parse(cfg.baseURL)
	if err != nil {
		return fmt.Errorf("parsing base URL: %w", err)
	}

	certManager := &autocert.Manager{
		Prompt:     autocert.AcceptTOS,
		Cache:      autocert.DirCache("./tmp/certs"),
		HostPolicy: autocert.HostWhitelist(u.Hostname()),
	}
{{- end}}

	// Initialize a channel to receive any errors that occur during the
	// graceful shutdown of the http.Server instance.
	shutdownError := make(chan error)

	// Initialize a goroutine that listens for interrupt or termination
	// signals and gracefully shuts down the http.Server instance.
	go func() {
		quit := make(chan os.Signal, 1)
		signal.Notify(quit, syscall.SIGINT, syscall.SIGTERM)
		<-quit

		logger.Info("shutting down server")

		// Call Shutdown() on the server with a context, which will do a
		// graceful shutdown without interrupting any active connections.
		// There is no timeout: shutdown completes when the last active
		// connection finishes.
		shutdownError <- srv.Shutdown(context.Background())
	}()

	logger.Info("starting server", "addr", srv.Addr)

	// Call ListenAndServe() to start the server. If it returns
	// http.ErrServerClosed then that means the server was shut down
	// gracefully and we can proceed; any other error is a problem.
{{- if .AutoHTTPS}}
	if u.Hostname() == "localhost" || u.Hostname() == "127.0.0.1" {
		logger.Warn("automatic HTTPS is disabled for local development; serving plain HTTP", "addr", srv.Addr)
		{{- if .NeedsDB}}
		err = srv.ListenAndServe()
		{{- else}}
		err := srv.ListenAndServe()
		{{- end}}
	} else {
		// Serve the ACME HTTP-01 challenge and redirect plain HTTP
		// traffic to HTTPS.
		go func() {
			redirectSrv := &http.Server{
				Addr:    fmt.Sprintf(":%d", cfg.httpPort),
				Handler: certManager.HTTPHandler(nil),
			}
			logger.Info("starting HTTP redirect server", "addr", redirectSrv.Addr)
			if err := redirectSrv.ListenAndServe(); !errors.Is(err, http.ErrServerClosed) {
				logger.Error("HTTP redirect server failed", "error", err)
			}
		}()

		srv.Addr = fmt.Sprintf(":%d", cfg.httpsPort)
		srv.TLSConfig = &tls.Config{GetCertificate: certManager.GetCertificate}
		logger.Info("starting HTTPS server", "addr", srv.Addr)
		err = srv.ListenAndServeTLS("", "")
	}
{{- else}}
{{- if .NeedsDB}}
	err = srv.ListenAndServe()
{{- else}}
	err := srv.ListenAndServe()
{{- end}}
{{- end}}
	if !errors.Is(err, http.ErrServerClosed) {
		return err
	}

	// Wait for the graceful shutdown to complete, and return any error
	// that occurred during it.
	err = <-shutdownError
	if err != nil {
		return err
	}

	logger.Info("stopped server", "addr", srv.Addr)

	return nil
}

// config holds the configuration settings for the application.
type config struct {
	baseURL  string
	httpPort int
{{- if .NeedsDB}}
	dbDSN         string
	dbMaxConns    int
	dbMinConns    int
	dbMaxIdleTime time.Duration
{{- if .Migrations}}
	dbAutomigrate bool
{{- end}}
{{- end}}
{{- if .BasicAuth}}
	basicAuthUsername string
	basicAuthPassword string
{{- end}}
{{- if .SecureCookies}}
	cookieSecretKey string
{{- end}}
{{- if .AccountsJWT}}
	jwtSecret string
{{- end}}
{{- if .NeedsMailer}}
	smtpHost     string
	smtpPort     int
	smtpUsername string
	smtpPassword string
	smtpFrom     string
{{- end}}
{{- if .ErrorNotifications}}
	adminEmail string
{{- end}}
{{- if .AutoHTTPS}}
	httpsPort int
{{- end}}
}

// application holds the dependencies of the application. Handlers, helpers
// and middleware are defined as methods on this type.
type application struct {
	config config
	logger *slog.Logger
{{- if .NeedsDB}}
	db     *sqlx.DB
{{- end}}
{{- if .NeedsMailer}}
	mailer mailer.Mailer
{{- end}}
{{- if .AccountsJWT}}
	tokenizer        auth.Tokenizer
	users            database.UserModel
	activationTokens database.ActivationTokenModel
{{- end}}
	wg     sync.WaitGroup
}

// newLogger returns a slog.Logger writing records to standard output in
// the configured format.
func newLogger() *slog.Logger {
{{- if eq .LogFormat "json"}}
	return slog.New(slog.NewJSONHandler(os.Stdout, nil))
{{- else if eq .LogFormat "colorized"}}
	return slog.New(log.NewColorizedHandler(os.Stdout))
{{- else}}
	return slog.New(slog.NewTextHandler(os.Stdout, nil))
{{- end}}
}
