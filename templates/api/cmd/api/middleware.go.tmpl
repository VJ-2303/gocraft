{{- if .RequestLogging}}

// logRequest logs every completed request with the client IP, protocol,
// method, URL, response status code and response body size.
func (app *application) logRequest(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		mw := &response.MetricsResponseWriter{ResponseWriter: w, Status: http.StatusOK}

		next.ServeHTTP(mw, r)

		app.logger.Info("request completed",
			slog.Group("user", "ip", clientIP(r)),
			slog.Group("request", "method", r.Method, "url", r.URL.RequestURI(), "proto", r.Proto),
			slog.Group("response", "status", mw.Status, "size", mw.Size),
		)
	})
}

// clientIP extracts the host portion of the remote address, which is
// the best available default for the client IP behind no proxy.
func clientIP(r *http.Request) string {
	host, _, err := net.SplitHostPort(r.RemoteAddr)
	if err != nil {
		return r.RemoteAddr
	}
	return host
}
{{- end}}
{{- if .BasicAuth}}

// basicAuth provides HTTP basic authentication for all routes, using the
// credentials configured at startup. Change the defaults for anything
// other than local development.
func (app *application) basicAuth(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
{{- if .AccountsJWT}}
		// Requests carrying a bearer token pass through to the JWT
		// middleware, which performs its own authentication; basic auth
		// continues to gate anonymous access to the remaining routes.
		if strings.HasPrefix(r.Header.Get("Authorization"), "Bearer ") {
			next.ServeHTTP(w, r)
			return
		}
{{- end}}
		username, plaintext, ok := r.BasicAuth()
		if !ok {
			app.basicAuthenticationRequired(w, r)
			return
		}

		matches, err := password.Matches(plaintext, []byte(app.config.basicAuth.hashedPassword))
		if err != nil || username != app.config.basicAuth.username || !matches {
			app.basicAuthenticationRequired(w, r)
			return
		}

		next.ServeHTTP(w, r)
	})
}
{{- end}}

// recoverPanic recovers from any panics in downstream handlers, logging
// the error and sending a 500 response instead of closing the connection
// abruptly. It also sets the Connection: close header on a panic so that
// keep-alive connections are not reused.
func (app *application) recoverPanic(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if err := recover(); err != nil {
				w.Header().Set("Connection", "close")
				app.serverError(w, r, fmt.Errorf("%s", err))
			}
		}()

		next.ServeHTTP(w, r)
	})
}

{{- if .AccountsJWT}}

// requireAuthenticatedUser verifies the Authorization: Bearer token,
// loads the matching user into the request context, and rejects the
// request when the token is missing, invalid or expired.
func (app *application) requireAuthenticatedUser(next http.HandlerFunc) http.HandlerFunc {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		token, ok := bearerToken(r)
		if !ok {
			app.invalidCredentials(w, r)
			return
		}

		claims, err := app.tokenizer.Verify(token)
		if err != nil {
			app.invalidCredentials(w, r)
			return
		}

		id, err := strconv.ParseInt(claims.Subject, 10, 64)
		if err != nil {
			app.invalidCredentials(w, r)
			return
		}

		user, found, err := app.users.Get(id)
		if err != nil {
			app.serverError(w, r, err)
			return
		}
		if !found || !user.Activated {
			app.invalidCredentials(w, r)
			return
		}

		next.ServeHTTP(w, contextSetAuthenticatedUser(r, user))
	})
}
{{- end}}

{{- if .BasicAuth}}

// basicAuthenticationRequired sends the 401 response and challenge
// header for failed HTTP basic authentication.
func (app *application) basicAuthenticationRequired(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("WWW-Authenticate", `Basic realm="restricted", charset="UTF-8"`)

	err := response.JSON(w, http.StatusUnauthorized, envelope{"Error": "provided credentials are invalid"})
	if err != nil {
		app.serverError(w, r, err)
	}
}
{{- end}}
