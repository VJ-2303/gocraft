{{- if .RequestLogging}}

// logRequest logs every request with the response status code, body size
// and duration.
func (app *application) logRequest(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		start := time.Now()

		interceptor := &statusInterceptor{ResponseWriter: w, status: http.StatusOK}

		next.ServeHTTP(interceptor, r)

		app.logger.Info("request",
			"method", r.Method,
			"uri", r.URL.RequestURI(),
			"status", interceptor.status,
			"size", interceptor.bytes,
			"duration", time.Since(start).String(),
		)
	})
}

// statusInterceptor records the status code and body size of a response.
type statusInterceptor struct {
	http.ResponseWriter
	status int
	bytes  int
}

func (w *statusInterceptor) WriteHeader(status int) {
	w.status = status
	w.ResponseWriter.WriteHeader(status)
}

func (w *statusInterceptor) Write(b []byte) (int, error) {
	n, err := w.ResponseWriter.Write(b)
	w.bytes += n
	return n, err
}
{{- end}}
{{- if .BasicAuth}}

// basicAuth provides HTTP basic authentication for all routes, using the
// credentials configured at startup. Change the defaults for anything
// other than local development.
func (app *application) basicAuth(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		username, password, ok := r.BasicAuth()
		if !ok {
			w.Header().Set("WWW-Authenticate", `Basic realm="restricted", charset="UTF-8"`)
			app.clientError(w, http.StatusUnauthorized)
			return
		}

		usernameMatches := subtle.ConstantTimeCompare([]byte(username), []byte(app.config.basicAuthUsername)) == 1
		passwordMatches := subtle.ConstantTimeCompare([]byte(password), []byte(app.config.basicAuthPassword)) == 1

		if !usernameMatches || !passwordMatches {
			w.Header().Set("WWW-Authenticate", `Basic realm="restricted", charset="UTF-8"`)
			app.clientError(w, http.StatusUnauthorized)
			return
		}

		next.ServeHTTP(w, r)
	})
}
{{- end}}

// recoverPanic recovers from any panics in downstream handlers, logging
// the error and sending a 500 response instead of closing the connection
// abruptly. It also sets the Connection: close header on a panic so that
// keep-alive connections are not reused.
func (app *application) recoverPanic(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if err := recover(); err != nil {
				w.Header().Set("Connection", "close")
				app.serverError(w, r, fmt.Errorf("%s", err))
			}
		}()

		next.ServeHTTP(w, r)
	})
}

{{- if .AccountsJWT}}

// requireAuthenticatedUser verifies the Authorization: Bearer token,
// loads the matching user into the request context, and rejects the
// request when the token is missing, invalid or expired.
func (app *application) requireAuthenticatedUser(next http.HandlerFunc) http.HandlerFunc {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		token, ok := bearerToken(r)
		if !ok {
			app.invalidCredentials(w, r)
			return
		}

		claims, err := app.tokenizer.Verify(token)
		if err != nil {
			app.invalidCredentials(w, r)
			return
		}

		id, err := strconv.ParseInt(claims.Subject, 10, 64)
		if err != nil {
			app.invalidCredentials(w, r)
			return
		}

		user, found, err := app.users.Get(id)
		if err != nil {
			app.serverError(w, r, err)
			return
		}
		if !found || !user.Activated {
			app.invalidCredentials(w, r)
			return
		}

		next.ServeHTTP(w, contextSetAuthenticatedUser(r, user))
	})
}
{{- end}}