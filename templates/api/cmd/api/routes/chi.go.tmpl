// The API's route table: URL-to-handler mappings and middleware assignment.
package main

import (
	"net/http"

	"github.com/go-chi/chi/v5"
)

// routes initializes the API's routes and middleware, and returns a
// http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := chi.NewRouter()

	mux.Get("/v1/healthcheck", app.healthcheck)

	return mux
}
