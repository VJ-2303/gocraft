// The API's route table: URL-to-handler mappings and middleware assignment.
package main

import (
	"net/http"

	"github.com/alexedwards/flow"
)

// routes initializes the API's routes and middleware, and returns a
// http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := flow.New()

	mux.HandleFunc("/v1/healthcheck", app.healthcheck, http.MethodGet)

{{- if .AccountsJWT}}

	// User account routes.
	mux.HandleFunc("/v1/users", app.registerUser, http.MethodPost)
	mux.HandleFunc("/v1/tokens/activation", app.activateUser, http.MethodPut)
	mux.HandleFunc("/v1/tokens/authentication", app.createAuthenticationToken, http.MethodPost)
	mux.HandleFunc("/v1/me", app.requireAuthenticatedUser(app.whoami), http.MethodGet)
{{- end}}
	// Apply the middleware chain, from the outside in.
	var handler http.Handler = mux
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(handler)

	return handler
}
