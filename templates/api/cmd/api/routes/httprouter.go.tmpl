// The API's route table: URL-to-handler mappings and middleware assignment.
package main

import (
	"net/http"

	"github.com/julienschmidt/httprouter"
)

// routes initializes the API's routes and middleware, and returns a
// http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := httprouter.New()

	mux.GET("/v1/healthcheck", func(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {
		app.healthcheck(w, r)
	})

{{- if .AccountsJWT}}

	handler := func(next http.HandlerFunc) httprouter.Handle {
		return func(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {
			next(w, r)
		}
	}

	mux.POST("/v1/users", handler(app.registerUser))
	mux.PUT("/v1/tokens/activation", handler(app.activateUser))
	mux.POST("/v1/tokens/authentication", handler(app.createAuthenticationToken))
	mux.GET("/v1/me", handler(app.requireAuthenticatedUser(app.whoami)))
{{- end}}
	var handler http.Handler = mux
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(handler)

	return handler
}
