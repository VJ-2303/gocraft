// The API's route table: URL-to-handler mappings and middleware assignment.
package main

import (
	"net/http"
)

// routes initializes the API's routes and middleware, and returns a
// http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := http.NewServeMux()

	mux.HandleFunc("GET /v1/healthcheck", app.healthcheck)

{{- if .AccountsJWT}}

	// User account routes.
	mux.HandleFunc("POST /v1/users", app.registerUser)
	mux.HandleFunc("PUT /v1/tokens/activation", app.activateUser)
	mux.HandleFunc("POST /v1/tokens/authentication", app.createAuthenticationToken)
	mux.HandleFunc("GET /v1/me", app.requireAuthenticatedUser(app.whoami))
{{- end}}
	// Apply the middleware chain, from the outside in.
	var handler http.Handler = mux
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(handler)

	return handler
}
