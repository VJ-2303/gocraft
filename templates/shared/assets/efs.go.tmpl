// Package assets embeds the non-code assets of the application.
package assets

import (
	"embed"
{{- if or (eq .AppType "web") .Migrations}}
	"io/fs"
{{- end}}
)
{{if eq .AppType "web"}}

// FS holds the embedded assets. Static files are served from /static/ and
// HTML templates are rendered from the html directory.
//
//go:embed static html
var FS embed.FS

// HTML holds the embedded HTML templates, rooted at the html directory.
var HTML = mustSub(FS, "html")
{{end}}
{{if .Migrations}}

// MigrationFiles holds the embedded SQL migrations.
//
//go:embed migrations
var MigrationFiles embed.FS

// Migrations holds the embedded SQL migrations, rooted at the migrations
// directory.
var Migrations = mustSub(MigrationFiles, "migrations")
{{end}}
{{if .NeedsMailer}}

// EmailFiles holds the embedded email templates, rooted at the emails
// directory.
//
//go:embed emails
var EmailFiles embed.FS
{{end}}
{{if or (eq .AppType "web") .Migrations}}

func mustSub(fsys fs.FS, dir string) fs.FS {
	sub, err := fs.Sub(fsys, dir)
	if err != nil {
		panic(err)
	}
	return sub
}
{{end}}
