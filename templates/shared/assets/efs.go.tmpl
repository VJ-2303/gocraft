// Package assets embeds the non-code assets of the application.
package assets

import (
	"embed"
	"io/fs"
)
{{if eq .AppType "web"}}

// StaticFiles holds the embedded static files (CSS, JavaScript and
// images), served from /static/, and the HTML templates.
//
//go:embed static html
var StaticFiles embed.FS

// HTMLFiles holds the embedded HTML templates, rooted at the html
// directory.
var HTMLFiles = mustSub(StaticFiles, "html")
{{end}}
{{if .Migrations}}

// MigrationFiles holds the embedded SQL migrations.
//
//go:embed migrations
var MigrationFiles embed.FS

// Migrations holds the embedded SQL migrations, rooted at the migrations
// directory.
var Migrations = mustSub(MigrationFiles, "migrations")
{{end}}
{{if .NeedsMailer}}

//go:embed emails
var emailFiles embed.FS

// EmailFiles holds the embedded email templates, rooted at the emails
// directory.
var EmailFiles = mustSub(emailFiles, "emails")
{{end}}
{{if or (eq .AppType "web") .Migrations .NeedsMailer}}

func mustSub(fsys fs.FS, dir string) fs.FS {
	sub, err := fs.Sub(fsys, dir)
	if err != nil {
		panic(err)
	}
	return sub
}
{{end}}
