{{- if eq .Dialect "sqlite"}}
CREATE TABLE IF NOT EXISTS password_resets (
	hashed_token VARBINARY(32) PRIMARY KEY,
	user_id INTEGER NOT NULL,
	expiry TIMESTAMP NOT NULL,
	FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX IF NOT EXISTS password_resets_user_id_idx ON password_resets(user_id);
{{- else if eq .Dialect "postgres"}}
CREATE TABLE IF NOT EXISTS password_resets (
	hashed_token BYTEA PRIMARY KEY,
	user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
	expiry TIMESTAMPTZ NOT NULL
);

CREATE INDEX IF NOT EXISTS password_resets_user_id_idx ON password_resets(user_id);
{{- else if eq .Dialect "mysql"}}
CREATE TABLE IF NOT EXISTS password_resets (
	hashed_token VARBINARY(32) PRIMARY KEY,
	user_id BIGINT UNSIGNED NOT NULL,
	expiry DATETIME(6) NOT NULL,
	CONSTRAINT password_resets_user_id_fk FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE
);

CREATE INDEX password_resets_user_id_idx ON password_resets(user_id);
{{- end}}
