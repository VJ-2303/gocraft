// Package cookies provides helpers for reading and writing cookie
// values, with optional HMAC-SHA256 signing (tamper-proof) or AES-GCM
// encryption (tamper-proof and confidential).
package cookies

import (
	"crypto/aes"
	"crypto/cipher"
	"crypto/hmac"
	"crypto/rand"
	"crypto/sha256"
	"encoding/base64"
	"errors"
	"io"
	"net/http"
	"strings"
)

// ErrInvalidValue is returned when a cookie value cannot be read,
// verified or decrypted.
var ErrInvalidValue = errors.New("invalid value")

// Write adds a cookie to the response, base64-encoding its value. Cookie
// values are limited to 4096 bytes.
func Write(w http.ResponseWriter, cookie http.Cookie) error {
	cookie.Value = base64.StdEncoding.EncodeToString([]byte(cookie.Value))

	if len(cookie.Value) > 4096 {
		return errors.New("cookie value must not be longer than 4096 bytes")
	}

	http.SetCookie(w, &cookie)
	return nil
}

// Read retrieves a cookie by name and base64-decodes its value. It
// returns http.ErrNoCookie when the cookie is missing, and
// ErrInvalidValue when the value cannot be decoded.
func Read(r *http.Request, name string) (string, error) {
	cookie, err := r.Cookie(name)
	if err != nil {
		return "", err
	}

	value, err := base64.StdEncoding.DecodeString(cookie.Value)
	if err != nil {
		return "", ErrInvalidValue
	}

	return string(value), nil
}

// WriteSigned adds a cookie to the response with an HMAC-SHA256
// signature appended to its value, so tampering is detectable. The
// secret key must be 32 characters.
func WriteSigned(w http.ResponseWriter, cookie http.Cookie, secretKey string) error {
	cookie.Value = base64.StdEncoding.EncodeToString([]byte(cookie.Value))

	if len(cookie.Value) > 4096 {
		return errors.New("cookie value must not be longer than 4096 bytes")
	}

	mac := hmac.New(sha256.New, []byte(secretKey))
	mac.Write([]byte(cookie.Name))
	mac.Write([]byte(cookie.Value))
	signature := mac.Sum(nil)

	cookie.Value = cookie.Value + "|" + base64.StdEncoding.EncodeToString(signature)

	http.SetCookie(w, &cookie)
	return nil
}

// ReadSigned retrieves a cookie by name and verifies its HMAC-SHA256
// signature. It returns ErrInvalidValue when the value has been tampered
// with.
func ReadSigned(r *http.Request, name string, secretKey string) (string, error) {
	cookie, err := r.Cookie(name)
	if err != nil {
		return "", err
	}

	value, signature, found := strings.Cut(cookie.Value, "|")
	if !found {
		return "", ErrInvalidValue
	}

	expected, err := base64.StdEncoding.DecodeString(signature)
	if err != nil {
		return "", ErrInvalidValue
	}

	mac := hmac.New(sha256.New, []byte(secretKey))
	mac.Write([]byte(cookie.Name))
	mac.Write([]byte(value))
	if !hmac.Equal(mac.Sum(nil), expected) {
		return "", ErrInvalidValue
	}

	decoded, err := base64.StdEncoding.DecodeString(value)
	if err != nil {
		return "", ErrInvalidValue
	}

	return string(decoded), nil
}

// WriteEncrypted adds a cookie to the response with an AES-GCM
// encrypted value, so its contents are confidential and tamper-proof.
// The secret key must be 32 characters.
func WriteEncrypted(w http.ResponseWriter, cookie http.Cookie, secretKey string) error {
	block, err := aes.NewCipher([]byte(secretKey))
	if err != nil {
		return err
	}

	aesgcm, err := cipher.NewGCM(block)
	if err != nil {
		return err
	}

	nonce := make([]byte, aesgcm.NonceSize())
	if _, err := io.ReadFull(rand.Reader, nonce); err != nil {
		return err
	}

	plaintext := base64.StdEncoding.EncodeToString([]byte(cookie.Value))
	ciphertext := aesgcm.Seal(nonce, nonce, []byte(plaintext), nil)

	cookie.Value = base64.StdEncoding.EncodeToString(ciphertext)

	if len(cookie.Value) > 4096 {
		return errors.New("cookie value must not be longer than 4096 bytes")
	}

	http.SetCookie(w, &cookie)
	return nil
}

// ReadEncrypted retrieves a cookie by name and decrypts its AES-GCM
// value. It returns ErrInvalidValue when the value cannot be decrypted
// or has been tampered with.
func ReadEncrypted(r *http.Request, name string, secretKey string) (string, error) {
	cookie, err := r.Cookie(name)
	if err != nil {
		return "", err
	}

	ciphertext, err := base64.StdEncoding.DecodeString(cookie.Value)
	if err != nil {
		return "", ErrInvalidValue
	}

	block, err := aes.NewCipher([]byte(secretKey))
	if err != nil {
		return "", err
	}

	aesgcm, err := cipher.NewGCM(block)
	if err != nil {
		return "", err
	}

	if len(ciphertext) < aesgcm.NonceSize() {
		return "", ErrInvalidValue
	}

	nonce := ciphertext[:aesgcm.NonceSize()]
	sealed := ciphertext[aesgcm.NonceSize():]

	plaintext, err := aesgcm.Open(nil, nonce, sealed, nil)
	if err != nil {
		return "", ErrInvalidValue
	}

	decoded, err := base64.StdEncoding.DecodeString(string(plaintext))
	if err != nil {
		return "", ErrInvalidValue
	}

	return string(decoded), nil
}
