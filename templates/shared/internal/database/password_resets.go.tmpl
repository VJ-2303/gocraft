package database

import (
	"time"

	"github.com/jmoiron/sqlx"
)

// PasswordReset represents a password reset token stored in the
// password_resets table. Only the SHA-256 hash of the token is stored;
// the plaintext token exists solely in the reset link that is emailed to
// the user.
type PasswordReset struct {
	UserID      int64     `db:"user_id"`
	HashedToken []byte    `db:"hashed_token"`
	Expiry      time.Time `db:"expiry"`
}

// PasswordResetModel wraps a sqlx.DB and provides methods for working
// with password reset tokens.
type PasswordResetModel struct {
	DB *sqlx.DB
}

// Insert stores a password reset token hash for the user, expiring after
// the given time-to-live.
func (m PasswordResetModel) Insert(userID int64, hashedToken []byte, ttl time.Duration) error {
	query := m.DB.Rebind("INSERT INTO password_resets (user_id, hashed_token, expiry) VALUES (?, ?, ?)")

	_, err := m.DB.Exec(query, userID, hashedToken, time.Now().UTC().Add(ttl))
	return err
}

// Get fetches the unexpired password reset matching the hashed token.
// The second return value reports whether a valid, unexpired token was
// found.
func (m PasswordResetModel) Get(hashedToken []byte) (*PasswordReset, bool, error) {
	query := m.DB.Rebind(`
		SELECT user_id, hashed_token, expiry
		FROM password_resets
		WHERE hashed_token = ? AND expiry > ?`)

	var reset PasswordReset
	err := m.DB.Get(&reset, query, hashedToken, time.Now().UTC())
	if err != nil {
		if isNoRows(err) {
			return nil, false, nil
		}
		return nil, false, err
	}

	return &reset, true, nil
}

// Delete removes every password reset token for the user, called after a
// successful password change.
func (m PasswordResetModel) Delete(userID int64) error {
	query := m.DB.Rebind("DELETE FROM password_resets WHERE user_id = ?")

	_, err := m.DB.Exec(query, userID)
	return err
}
