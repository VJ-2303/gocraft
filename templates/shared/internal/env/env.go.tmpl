// Package env provides helpers for reading environment variables with
// fallback values. Each helper returns the fallback when the variable is
// not set, and panics when the variable is set but cannot be parsed —
// failing fast at startup is preferable to running with a surprise value.
package env

import (
	"log"
	"os"
	"strconv"
	"strings"
	"time"
)

// GetString returns the value of the environment variable named by key, or
// fallback if the variable is not set.
func GetString(key, fallback string) string {
	value, ok := os.LookupEnv(key)
	if !ok {
		return fallback
	}
	return value
}

// GetInt returns the integer value of the environment variable named by
// key, or fallback if the variable is not set. Panics if the value cannot
// be parsed as an integer.
func GetInt(key string, fallback int) int {
	value, ok := os.LookupEnv(key)
	if !ok {
		return fallback
	}

	i, err := strconv.Atoi(value)
	if err != nil {
		log.Panicf("environment variable %s is not an integer: %v", key, err)
	}
	return i
}

// GetBool returns the boolean value of the environment variable named by
// key, or fallback if the variable is not set. The values "1", "t" and
// "true" (case-insensitive) are accepted as true, and "0", "f" and "false"
// as false. Panics on any other value.
func GetBool(key string, fallback bool) bool {
	value, ok := os.LookupEnv(key)
	if !ok {
		return fallback
	}

	switch strings.ToLower(value) {
	case "1", "t", "true":
		return true
	case "0", "f", "false":
		return false
	default:
		log.Panicf("environment variable %s is not a recognized boolean: %q", key, value)
		return fallback
	}
}

// GetDuration returns the duration value of the environment variable named
// by key, or fallback if the variable is not set. Panics if the value
// cannot be parsed as a duration.
func GetDuration(key string, fallback time.Duration) time.Duration {
	value, ok := os.LookupEnv(key)
	if !ok {
		return fallback
	}

	d, err := time.ParseDuration(value)
	if err != nil {
		log.Panicf("environment variable %s is not a duration: %v", key, err)
	}
	return d
}
