// Package request contains helpers for reading data from HTTP requests.
package request

import (
	"fmt"
	"net/http"

	"github.com/go-playground/form/v4"

	"{{.ModulePath}}/internal/response"
)

// maxBytes limits the size of request bodies to 1MB, preventing
// accidental or deliberate large payloads from exhausting server memory.
const maxBytes = 1 << 20

// decoder parses form data into structs using go-playground/form.
// Fields map by the name attribute of each input; use a form:"-" tag to
// skip a field.
var decoder = form.NewDecoder()

// DecodePostForm fills dst with the parsed POST form data of the
// request. The request body is limited to maxBytes; malformed or
// oversized bodies return a response.BadRequestError.
func DecodePostForm(w http.ResponseWriter, r *http.Request, dst any) error {
	r.Body = http.MaxBytesReader(w, r.Body, maxBytes)

	err := r.ParseForm()
	if err != nil {
		return &response.BadRequestError{Message: "unable to parse form data"}
	}

	err = decoder.Decode(dst, r.PostForm)
	if err != nil {
		return &response.BadRequestError{Message: fmt.Sprintf("unable to decode form data: %v", err)}
	}

	return nil
}

// DecodeQueryString fills dst with the parsed query string values of the
// request URL. Malformed values return a response.BadRequestError.
func DecodeQueryString(r *http.Request, dst any) error {
	err := decoder.Decode(dst, r.URL.Query())
	if err != nil {
		return &response.BadRequestError{Message: fmt.Sprintf("unable to decode query string: %v", err)}
	}

	return nil
}
