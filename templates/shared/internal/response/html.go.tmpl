package response

import (
	"fmt"
	"io/fs"
	"net/http"
	"text/template"
)

// HTMLRenderer renders the application's HTML page templates. Templates
// are parsed once at initialization and cached, so rendering a page does
// not re-parse template files on each request.
type HTMLRenderer struct {
	cache map[string]*template.Template
}

// NewHTMLRenderer parses each named page template from fsys — together
// with the base template and all component templates — and returns a
// renderer with the parsed templates cached. The funcs map is made
// available to all templates.
func NewHTMLRenderer(fsys fs.FS, funcs template.FuncMap, pages ...string) (*HTMLRenderer, error) {
	cache := make(map[string]*template.Template, len(pages))

	for _, page := range pages {
		name := page
		paths := []string{
			"base.tmpl",
			"components/*.tmpl",
			"pages/" + page,
		}

		tmpl, err := template.New(name).Funcs(funcs).ParseFS(fsys, paths...)
		if err != nil {
			return nil, fmt.Errorf("parsing template %s: %w", page, err)
		}

		cache[page] = tmpl
	}

	return &HTMLRenderer{cache: cache}, nil
}

// Render writes an HTML response by executing the named page template with
// the given status code and data.
func (h *HTMLRenderer) Render(w http.ResponseWriter, status int, page string, data any) error {
	tmpl, ok := h.cache[page]
	if !ok {
		return fmt.Errorf("template %q is not in the renderer cache", page)
	}

	w.Header().Set("Content-Type", "text/html; charset=utf-8")
	w.WriteHeader(status)

	return tmpl.ExecuteTemplate(w, "base", data)
}
