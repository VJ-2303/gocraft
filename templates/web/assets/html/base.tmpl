{{define "base"}}
<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{{template "page:title" .}}</title>
	{{template "page:meta" .}}
	<link rel="stylesheet" href="/static/css/main.css">
</head>
<body>
	<header>
		<a class="site-title" href="/">My Application</a>
		{{template "component:nav" .}}
	</header>
	<main>
		{{template "page:main" .}}
	</main>
	<footer>
		<p>&copy; {{year}} My Application</p>
	</footer>
</body>
</html>
{{end}}

{{define "page:meta"}}{{end}}
