{{define "title"}}Forgotten password{{end}}

{{define "content"}}
<h1>Forgotten your password?</h1>
<p>Enter your email address and we will send you a link to reset your
password.</p>

<form action="/forgotten-password" method="POST" novalidate>
	<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

	<label for="email">Email</label>
	<input type="email" id="email" name="email" value="{{.Form.Email}}">
	{{with .Form.FieldErrors.email}}<p class="error">{{.}}</p>{{end}}

	<button type="submit">Email me a reset link</button>
</form>
{{end}}
