{{define "page:title"}}Forgotten password{{end}}

{{define "page:main"}}
<h1>Forgotten your password</h1>
<p>Enter your email address and a password reset link will be sent to
you.</p>

<form action="/forgotten-password" method="POST" novalidate>
	<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

	<label for="email">Email</label>
	<input type="email" id="email" name="email" value="{{.Form.Email}}">
	{{with .Form.FieldErrors.email}}<p class="error">{{.}}</p>{{end}}

	<button type="submit">Send reset link</button>
</form>
{{end}}
