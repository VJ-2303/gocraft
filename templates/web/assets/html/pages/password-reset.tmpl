{{define "title"}}Choose a new password{{end}}

{{define "content"}}
<h1>Choose a new password</h1>

<form action="/password-reset/{{.Token}}" method="POST" novalidate>
	<input type="hidden" name="csrf_token" value="{{.CSRFToken}}">

	<label for="newPassword">New password</label>
	<input type="password" id="newPassword" name="newPassword">
	{{with .Form.FieldErrors.newPassword}}<p class="error">{{.}}</p>{{end}}
	<p class="hint">At least 8 characters, at most 72, and not a common password.</p>

	<button type="submit">Save new password</button>
</form>
{{end}}
