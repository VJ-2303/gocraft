// The application's error-handling helpers.
package main

import (
	"errors"
	"net/http"
	"runtime/debug"

	"{{.ModulePath}}/internal/response"
)

// reportServerError logs an error at the ERROR level{{if .ErrorNotifications}} and emails an
// alert with the details to the configured admin address{{end}}. It does not
// send an HTTP response.
func (app *application) reportServerError(r *http.Request, err error) {
	var (
		method = r.Method
		uri    = r.URL.RequestURI()
		trace  = string(debug.Stack())
	)

	app.logger.Error(err.Error(), "method", method, "uri", uri, "trace", trace)
{{- if .ErrorNotifications}}

	// Notifications are only sent when a recipient address is
	// configured; errors are always logged regardless.
	if app.config.notifications.email != "" {
		// The notification runs via the wait group directly rather than
		// backgroundTask, so a failed send is logged without recursing
		// back into reportServerError.
		app.wg.Go(func() {
			data := app.defaultEmailData()
			data["Method"] = method
			data["URI"] = uri
			data["Trace"] = trace
			data["Error"] = err.Error()

			if sendErr := app.mailer.Send(app.config.notifications.email, data, "error-notification.tmpl"); sendErr != nil {
				app.logger.Error("sending error notification", "error", sendErr)
			}
		})
	}
{{- end}}
}

// serverError reports the error and sends a 500 Internal Server Error
// response to the client.
func (app *application) serverError(w http.ResponseWriter, r *http.Request, err error) {
	app.reportServerError(r, err)
{{- if .CustomErrorPages}}
	data := app.defaultHTMLData(r)
	data["ErrorNotifications"] = {{if .ErrorNotifications}}true{{else}}false{{end}}
	app.render(w, r, http.StatusInternalServerError, "pages/errors/500.tmpl", data)
{{- else}}
	http.Error(w, http.StatusText(http.StatusInternalServerError), http.StatusInternalServerError)
{{- end}}
}

// clientError sends a specific status code to the client.
func (app *application) clientError(w http.ResponseWriter, r *http.Request, status int) {
	http.Error(w, http.StatusText(status), status)
}

// notFound sends a 404 Not Found response to the client.
func (app *application) notFound(w http.ResponseWriter, r *http.Request) {
{{- if .CustomErrorPages}}
	app.render(w, r, http.StatusNotFound, "pages/errors/404.tmpl", app.defaultHTMLData(r))
{{- else}}
	http.Error(w, http.StatusText(http.StatusNotFound), http.StatusNotFound)
{{- end}}
}

// badRequest sends a 400 Bad Request response for problems with the
// client's request, such as malformed form data or query strings.
func (app *application) badRequest(w http.ResponseWriter, r *http.Request, err error) {
	var badRequestErr *response.BadRequestError
	if errors.As(err, &badRequestErr) {
{{- if .CustomErrorPages}}
		data := app.defaultHTMLData(r)
		data["Message"] = badRequestErr.Message
		app.render(w, r, http.StatusBadRequest, "pages/errors/400.tmpl", data)
{{- else}}
		http.Error(w, badRequestErr.Message, http.StatusBadRequest)
{{- end}}
		return
	}

	app.serverError(w, r, err)
}
{{- if .BasicAuth}}

// basicAuthenticationRequired sends the 401 Unauthorized response and
// challenge header for failed HTTP basic authentication.
func (app *application) basicAuthenticationRequired(w http.ResponseWriter, r *http.Request) {
	w.Header().Set("WWW-Authenticate", `Basic realm="restricted", charset="UTF-8"`)
{{- if .CustomErrorPages}}
	app.render(w, r, http.StatusUnauthorized, "pages/errors/401.tmpl", app.defaultHTMLData(r))
{{- else}}
	http.Error(w, http.StatusText(http.StatusUnauthorized), http.StatusUnauthorized)
{{- end}}
}
{{- end}}
