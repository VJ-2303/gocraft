// Miscellaneous helper functions for the application.
package main

import (
	"fmt"
	"net/http"
	"time"
{{- if .AccountsFull}}
	"github.com/justinas/nosurf"
{{- end}}

	"{{.ModulePath}}/internal/version"
)

{{- if .NeedsMailer}}

// defaultEmailData returns a map with common data shared by all email
// templates. Additional template-specific data can be added to the map by
// the caller.
func (app *application) defaultEmailData() templateData {
	return templateData{
		"BaseURL": app.config.baseURL,
	}
}
{{- end}}

// defaultHTMLData returns a map with common data shared by all HTML
// templates. Additional template-specific data can be added to the map by
// handlers.
func (app *application) defaultHTMLData(r *http.Request) templateData {
	data := templateData{
		"BaseURL":  app.config.baseURL,
		"Year":     time.Now().Year(),
		"Version":  version.Get(),
		"Revision": version.GetRevision(),

		"ErrorNotifications": {{if .ErrorNotifications}}true{{else}}false{{end}},
	}
{{- if .AccountsFull}}

	// Every form template can render the CSRF token, and every template
	// can branch on the authenticated user.
	data["CSRFToken"] = nosurf.Token(r)

	if user, ok := contextGetAuthenticatedUser(r); ok {
		data["AuthenticatedUser"] = user
	}
{{- end}}

	return data
}

// backgroundTask runs fn in a background goroutine after the HTTP
// response has been sent. Panics are recovered, and both panics and
// returned errors are reported through reportServerError, so they are
// logged (and emailed) like request errors. The application waits for
// outstanding background tasks to complete before shutting down.
func (app *application) backgroundTask(r *http.Request, fn func() error) {
	app.wg.Go(func() {
		defer func() {
			if err := recover(); err != nil {
				app.reportServerError(r, fmt.Errorf("%s", err))
			}
		}()

		err := fn()
		if err != nil {
			app.reportServerError(r, err)
		}
	})
}
