	"net/http/cookiejar"
	"net/http/httptest"
	"net/url"
	"os"
	"strings"
	"testing"
{{- if .Sessions}}
	"time"
{{- end}}
{{- if .Sessions}}
	"github.com/alexedwards/scs/v2"
	"github.com/alexedwards/scs/v2/memstore"
{{- end}}
{{- if .NeedsDB}}
	"github.com/jmoiron/sqlx"

	"{{.ModulePath}}/internal/database"
{{- end}}
