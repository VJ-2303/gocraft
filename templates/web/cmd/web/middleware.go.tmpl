{{- if .RequestLogging}}

// logRequest logs every completed request with the client IP, protocol,
// method, URL, response status code and response body size.
func (app *application) logRequest(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		mw := &response.MetricsResponseWriter{ResponseWriter: w, Status: http.StatusOK}

		next.ServeHTTP(mw, r)

		app.logger.Info("request completed",
			slog.Group("user", "ip", clientIP(r)),
			slog.Group("request", "method", r.Method, "url", r.URL.RequestURI(), "proto", r.Proto),
			slog.Group("response", "status", mw.Status, "size", mw.Size),
		)
	})
}

// clientIP extracts the host portion of the remote address, which is
// the best available default for the client IP behind no proxy.
func clientIP(r *http.Request) string {
	host, _, err := net.SplitHostPort(r.RemoteAddr)
	if err != nil {
		return r.RemoteAddr
	}
	return host
}
{{- end}}
{{- if .BasicAuth}}

// basicAuth provides HTTP basic authentication, verifying the submitted
// password against the configured bcrypt hash. Change the defaults for
// anything other than local development.
func (app *application) basicAuth(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		username, plaintext, ok := r.BasicAuth()
		if !ok {
			app.basicAuthenticationRequired(w, r)
			return
		}

		matches, err := password.Matches(plaintext, []byte(app.config.basicAuth.hashedPassword))
		if err != nil || username != app.config.basicAuth.username || !matches {
			app.basicAuthenticationRequired(w, r)
			return
		}

		next.ServeHTTP(w, r)
	})
}
{{- end}}

// recoverPanic recovers from any panics in downstream handlers, logging
// the error and sending a 500 response instead of closing the connection
// abruptly. It also sets the Connection: close header on a panic so that
// keep-alive connections are not reused.
func (app *application) recoverPanic(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if err := recover(); err != nil {
				w.Header().Set("Connection", "close")
				app.serverError(w, r, fmt.Errorf("%s", err))
			}
		}()

		next.ServeHTTP(w, r)
	})
}

// secureHeaders sets a couple of security-related headers on every
// response, providing a first line of defense against XSS and
// clickjacking attacks.
func (app *application) secureHeaders(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		w.Header().Set("X-Content-Type-Options", "nosniff")
		w.Header().Set("X-Frame-Options", "deny")
		w.Header().Set("Referrer-Policy", "no-referrer")

		next.ServeHTTP(w, r)
	})
}
{{- if .AccountsFull}}

// authenticate reads the authenticated user ID from the session, looks
// up the corresponding user, and stores it in the request context for
// downstream handlers and templates.
func (app *application) authenticate(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		id := app.sessionManager.GetInt(r.Context(), "authenticatedUserID")
		if id <= 0 {
			next.ServeHTTP(w, r)
			return
		}

		user, found, err := app.users.Get(int64(id))
		if err != nil {
			app.serverError(w, r, err)
			return
		}
		if !found {
			// The session refers to a user that no longer exists.
			next.ServeHTTP(w, r)
			return
		}

		next.ServeHTTP(w, contextSetAuthenticatedUser(r, user))
	})
}

// requireAuthentication redirects anonymous users to the login page,
// remembering the requested path so the login handler can send them back
// after signing in.
func (app *application) requireAuthentication(next http.HandlerFunc) http.HandlerFunc {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if _, authenticated := contextGetAuthenticatedUser(r); !authenticated {
			app.sessionManager.Put(r.Context(), "redirectPathAfterLogin", r.URL.RequestURI())
			http.Redirect(w, r, "/login", http.StatusSeeOther)
			return
		}

		w.Header().Add("Cache-Control", "no-store")

		next.ServeHTTP(w, r)
	})
}

// requireAnonymous redirects authenticated users away from pages meant
// only for signed-out users, like signup and login.
func (app *application) requireAnonymous(next http.HandlerFunc) http.HandlerFunc {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		if _, authenticated := contextGetAuthenticatedUser(r); authenticated {
			http.Redirect(w, r, "/restricted", http.StatusSeeOther)
			return
		}

		next.ServeHTTP(w, r)
	})
}

// preventCSRF rejects any non-safe request that does not carry a valid
// CSRF token, using the justinas/nosurf package. Forms must include the
// hidden input rendered by the CSRFToken template value.
func (app *application) preventCSRF(next http.Handler) http.Handler {
	csrfHandler := nosurf.New(next)
	csrfHandler.SetBaseCookie(http.Cookie{
		HttpOnly: true,
		Path:     "/",
		Secure:   app.sessionManager.Cookie.Secure,
	})
	csrfHandler.SetIsTLSFunc(func(r *http.Request) bool {
		// Determine the request scheme from the connection, so origin
		// checks pass for both local HTTP development and production
		// HTTPS deployments behind the automatic HTTPS configuration.
		return r.TLS != nil
	})
	csrfHandler.SetFailureHandler(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		app.badRequest(w, r, errCSRF)
	}))

	return csrfHandler
}

// errCSRF is the error reported when CSRF validation fails.
var errCSRF = &response.BadRequestError{Message: "CSRF token validation failed"}
{{- end}}
