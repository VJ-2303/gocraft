// The application's route table: URL-to-handler mappings and middleware
// assignment.
package main

import (
	"net/http"

	"github.com/go-chi/chi/v5"
)

// routes initializes the application's routes and middleware, and returns
// a http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := chi.NewRouter()

	// Serve static files from the embedded assets.
	mux.Handle("/static/*", http.FileServerFS(app.assets))

	// Application routes.
	mux.Get("/", app.home)

	// Any other path is not found.
	mux.NotFound(http.HandlerFunc(app.notFound))
{{if .AccountsFull}}

	// User account routes.
	mux.Get("/restricted", app.requireAuthentication(app.restricted))
	mux.Get("/signup", app.requireAnonymous(app.signup))
	mux.Post("/signup", app.requireAnonymous(app.signupSubmit))
	mux.Get("/login", app.requireAnonymous(app.login))
	mux.Post("/login", app.requireAnonymous(app.loginSubmit))
	mux.Post("/logout", app.requireAuthentication(app.logout))
	mux.Get("/forgotten-password", app.requireAnonymous(app.forgottenPassword))
	mux.Post("/forgotten-password", app.requireAnonymous(app.forgottenPasswordSubmit))
	mux.Get("/forgotten-password-confirmation", app.requireAnonymous(app.forgottenPasswordConfirmation))
	mux.Get("/password-reset/{token}", app.requireAnonymous(app.passwordReset))
	mux.Post("/password-reset/{token}", app.requireAnonymous(app.passwordResetSubmit))
	mux.Get("/password-reset-confirmation", app.requireAnonymous(app.passwordResetConfirmation))
{{end}}
	// Apply the middleware chain, from the outside in.
	var handler http.Handler = mux
{{- if .AccountsFull}}
	handler = app.authenticate(handler)
	handler = app.preventCSRF(handler)
{{- end}}
{{- if .Sessions}}
	handler = app.sessionManager.LoadAndSave(handler)
{{- end}}
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(app.secureHeaders(handler))

	return handler
}

{{- if .AccountsFull}}

// pathParam extracts a named path parameter from the request.
func pathParam(r *http.Request, name string) string {
	return chi.URLParam(r, name)
}
{{- end}}
