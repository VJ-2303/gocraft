// The application's route table: URL-to-handler mappings and middleware
// assignment.
package main

import (
	"net/http"

	"github.com/alexedwards/flow"
)

// routes initializes the application's routes and middleware, and returns
// a http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := flow.New()

	// Serve static files from the embedded assets.
	mux.Handle("/static/", http.FileServerFS(app.static), http.MethodGet)

	// Application routes.
	mux.HandleFunc("/", app.home, http.MethodGet)
{{if .BasicAuth}}
	mux.HandleFunc("/restricted-basic-auth", app.restrictedBasicAuth, http.MethodGet)
{{end}}

	// Any other path is not found.
	mux.NotFound = http.HandlerFunc(app.notFound)
{{if .AccountsFull}}

	// User account routes.
	mux.HandleFunc("/restricted", app.requireAuthentication(app.restricted), http.MethodGet)
	mux.HandleFunc("/signup", app.requireAnonymous(app.signup), http.MethodGet)
	mux.HandleFunc("/signup", app.requireAnonymous(app.signupSubmit), http.MethodPost)
	mux.HandleFunc("/login", app.requireAnonymous(app.login), http.MethodGet)
	mux.HandleFunc("/login", app.requireAnonymous(app.loginSubmit), http.MethodPost)
	mux.HandleFunc("/logout", app.requireAuthentication(app.logout), http.MethodPost)
	mux.HandleFunc("/forgotten-password", app.requireAnonymous(app.forgottenPassword), http.MethodGet)
	mux.HandleFunc("/forgotten-password", app.requireAnonymous(app.forgottenPasswordSubmit), http.MethodPost)
	mux.HandleFunc("/forgotten-password-confirmation", app.requireAnonymous(app.forgottenPasswordConfirmation), http.MethodGet)
	mux.HandleFunc("/password-reset/:token", app.requireAnonymous(app.passwordReset), http.MethodGet)
	mux.HandleFunc("/password-reset/:token", app.requireAnonymous(app.passwordResetSubmit), http.MethodPost)
	mux.HandleFunc("/password-reset-confirmation", app.requireAnonymous(app.passwordResetConfirmation), http.MethodGet)
{{end}}
	// Apply the middleware chain, from the outside in.
	var handler http.Handler = mux
{{- if .AccountsFull}}
	handler = app.authenticate(handler)
	handler = app.preventCSRF(handler)
{{- end}}
{{- if .Sessions}}
	handler = app.sessionManager.LoadAndSave(handler)
{{- end}}
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(app.secureHeaders(handler))

	return handler
}

{{- if .AccountsFull}}

// pathParam extracts a named path parameter from the request.
func pathParam(r *http.Request, name string) string {
	return flow.Param(r.Context(), name)
}
{{- end}}
