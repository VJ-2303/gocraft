// The application's route table: URL-to-handler mappings and middleware
// assignment.
package main

import (
	"net/http"

	"github.com/alexedwards/flow/v2"
)

// routes initializes the application's routes and middleware, and returns
// a http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := flow.New()

	// Serve static files from the embedded assets.
	mux.Handle(http.MethodGet, "/static/", http.FileServerFS(app.assets))

	// Application routes.
	mux.HandleFunc(http.MethodGet, "/", app.home)

	// Apply the middleware chain, from the outside in.
	var handler http.Handler = mux
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(app.secureHeaders(handler))

	return handler
}
