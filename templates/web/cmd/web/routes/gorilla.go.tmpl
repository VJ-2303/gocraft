// The application's route table: URL-to-handler mappings and middleware
// assignment.
package main

import (
	"net/http"

	"github.com/gorilla/mux"
)

// routes initializes the application's routes and middleware, and returns
// a http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := mux.NewRouter()

	mux.PathPrefix("/static/").Handler(http.FileServerFS(app.static))

	mux.HandleFunc("/", app.home).Methods(http.MethodGet)
{{if .BasicAuth}}
	mux.HandleFunc("/restricted-basic-auth", app.restrictedBasicAuth).Methods(http.MethodGet)
{{end}}

	mux.NotFoundHandler = http.HandlerFunc(app.notFound)
{{if .AccountsFull}}

	mux.HandleFunc("/restricted", app.requireAuthentication(app.restricted)).Methods(http.MethodGet)
	mux.HandleFunc("/signup", app.requireAnonymous(app.signup)).Methods(http.MethodGet)
	mux.HandleFunc("/signup", app.requireAnonymous(app.signupSubmit)).Methods(http.MethodPost)
	mux.HandleFunc("/login", app.requireAnonymous(app.login)).Methods(http.MethodGet)
	mux.HandleFunc("/login", app.requireAnonymous(app.loginSubmit)).Methods(http.MethodPost)
	mux.HandleFunc("/logout", app.requireAuthentication(app.logout)).Methods(http.MethodPost)
	mux.HandleFunc("/forgotten-password", app.requireAnonymous(app.forgottenPassword)).Methods(http.MethodGet)
	mux.HandleFunc("/forgotten-password", app.requireAnonymous(app.forgottenPasswordSubmit)).Methods(http.MethodPost)
	mux.HandleFunc("/forgotten-password-confirmation", app.requireAnonymous(app.forgottenPasswordConfirmation)).Methods(http.MethodGet)
	mux.HandleFunc("/password-reset/{token}", app.requireAnonymous(app.passwordReset)).Methods(http.MethodGet)
	mux.HandleFunc("/password-reset/{token}", app.requireAnonymous(app.passwordResetSubmit)).Methods(http.MethodPost)
	mux.HandleFunc("/password-reset-confirmation", app.requireAnonymous(app.passwordResetConfirmation)).Methods(http.MethodGet)
{{end}}
	var handler http.Handler = mux
{{- if .AccountsFull}}
	handler = app.authenticate(handler)
	handler = app.preventCSRF(handler)
{{- end}}
{{- if .Sessions}}
	handler = app.sessionManager.LoadAndSave(handler)
{{- end}}
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(app.secureHeaders(handler))

	return handler
}

{{- if .AccountsFull}}

// pathParam extracts a named path parameter from the request.
func pathParam(r *http.Request, name string) string {
	return mux.Vars(r)[name]
}
{{- end}}
