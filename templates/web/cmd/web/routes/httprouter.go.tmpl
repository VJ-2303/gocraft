// The application's route table: URL-to-handler mappings and middleware
// assignment.
package main

import (
	"net/http"

	"github.com/julienschmidt/httprouter"
)

// routes initializes the application's routes and middleware, and returns
// a http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := httprouter.New()

	// Serve static files from the embedded assets.
	mux.Handler(http.MethodGet, "/static/*filepath", http.FileServerFS(app.assets))

	// Application routes.
	mux.GET("/", func(w http.ResponseWriter, r *http.Request, _ httprouter.Params) {
		app.home(w, r)
	})

	return mux
}
