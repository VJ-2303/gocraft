// The application's route table: URL-to-handler mappings and middleware
// assignment.
package main

import (
	"net/http"
)

// routes initializes the application's routes and middleware, and returns
// a http.Handler ready to serve requests.
func (app *application) routes() http.Handler {
	mux := http.NewServeMux()

	// Serve static files from the embedded assets.
	mux.Handle("GET /static/", http.FileServerFS(app.static))

	// Application routes.
	mux.HandleFunc("GET /{$}", app.home)
{{if .BasicAuth}}
	mux.HandleFunc("GET /restricted-basic-auth", app.restrictedBasicAuth)
{{end}}

	// Any other path is not found.
	mux.HandleFunc("/", app.notFound)
{{if .AccountsFull}}

	// User account routes.
	mux.HandleFunc("GET /restricted", app.requireAuthentication(app.restricted))
	mux.HandleFunc("GET /signup", app.requireAnonymous(app.signup))
	mux.HandleFunc("POST /signup", app.requireAnonymous(app.signupSubmit))
	mux.HandleFunc("GET /login", app.requireAnonymous(app.login))
	mux.HandleFunc("POST /login", app.requireAnonymous(app.loginSubmit))
	mux.HandleFunc("POST /logout", app.requireAuthentication(app.logout))
	mux.HandleFunc("GET /forgotten-password", app.requireAnonymous(app.forgottenPassword))
	mux.HandleFunc("POST /forgotten-password", app.requireAnonymous(app.forgottenPasswordSubmit))
	mux.HandleFunc("GET /forgotten-password-confirmation", app.requireAnonymous(app.forgottenPasswordConfirmation))
	mux.HandleFunc("GET /password-reset/{token}", app.requireAnonymous(app.passwordReset))
	mux.HandleFunc("POST /password-reset/{token}", app.requireAnonymous(app.passwordResetSubmit))
	mux.HandleFunc("GET /password-reset-confirmation", app.requireAnonymous(app.passwordResetConfirmation))
{{end}}
	// Apply the middleware chain, from the outside in.
	var handler http.Handler = mux
{{- if .AccountsFull}}
	handler = app.authenticate(handler)
	handler = app.preventCSRF(handler)
{{- end}}
{{- if .Sessions}}
	handler = app.sessionManager.LoadAndSave(handler)
{{- end}}
{{- if .BasicAuth}}
	handler = app.basicAuth(handler)
{{- end}}
{{- if .RequestLogging}}
	handler = app.logRequest(handler)
{{- end}}
	handler = app.recoverPanic(app.secureHeaders(handler))

	return handler
}

{{- if .AccountsFull}}

// pathParam extracts a named path parameter from the request.
func pathParam(r *http.Request, name string) string {
	return r.PathValue(name)
}
{{- end}}
